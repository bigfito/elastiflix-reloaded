<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.bigfito</groupId>
        <artifactId>elastiflix-reloaded</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>elastiflix-core</artifactId>
    <name>elastiflix-core</name>
    <description>Modelo, cliente de Elasticsearch, catálogo y embeddings.</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-elasticsearch</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- Solo por WebServerApplicationContext: CatalogBootstrapRunner pregunta si hay servidor web.
             Opcional para que search e ingest no la hereden; la web ya la trae con su starter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-web-server</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Hay que repetir los recursos propios: si no, se pierde META-INF/spring.factories. -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../elasticsearch</directory>
                <includes>
                    <include>elastiflix-reloaded-mapping.json</include>
                </includes>
                <targetPath>elasticsearch</targetPath>
            </resource>
        </resources>
    </build>
</project>
