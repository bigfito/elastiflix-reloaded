# Finales de línea coherentes entre Windows, macOS y Linux
* text=auto eol=lf

# Scripts de Windows
*.cmd text eol=crlf
*.bat text eol=crlf

# Maven Wrapper (debe ejecutarse en Git Bash, WSL, macOS y Linux)
mvnw text eol=lf

# Fixtures: se conservan byte a byte (el CSV usa \r\n entre filas y \n dentro de celdas)
elasticsearch/fixtures/** -text

# Binarios
*.png binary
*.jpg binary
*.jar binary
