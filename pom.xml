<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.bigfito</groupId>
    <artifactId>elastiflix-reloaded</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>elastiflix-reloaded</name>
    <description>Demo de búsqueda full-text, vectorial e híbrida sobre Elasticsearch Serverless.</description>

    <modules>
        <module>elastiflix-core</module>
        <module>elastiflix-search</module>
        <module>elastiflix-ingest</module>
        <module>elastiflix-web</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <checkstyle.version>14.3.0</checkstyle.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <pmd.version>7.28.0</pmd.version>
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
        <archunit.version>1.5.1</archunit.version>
        <!-- El plan no fija esta versión; 3.6.3 es la estable vigente al generar el POM. -->
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    </properties>

    <!-- Los módulos no declaran versiones: Boot o este bloque las fijan. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.bigfito</groupId>
                <artifactId>elastiflix-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bigfito</groupId>
                <artifactId>elastiflix-search</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bigfito</groupId>
                <artifactId>elastiflix-ingest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bigfito</groupId>
                <artifactId>elastiflix-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit6</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <configuration>
                    <rules>
                        <requireJavaVersion>
                            <version>[25,)</version>
                        </requireJavaVersion>
                        <requireMavenVersion>
                            <version>[3.6.3,)</version>
                        </requireMavenVersion>
                    </rules>
                </configuration>
                <executions>
                    <execution>
                        <id>enforce-java-and-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
